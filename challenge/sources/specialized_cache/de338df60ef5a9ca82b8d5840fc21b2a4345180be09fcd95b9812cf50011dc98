# Reference: https://github.com/project-sekai-ctf/konata
challenges:
  - category: pwn
    name: MTE
    author: Qyn
    description: |
      Miku found all these bugs, you should put them together! You might want to involve some crypto as well!

      > [!NOTE]
      > The architecture of the nodes that the instancer is using for this challenge is aarch64

      > [!NOTE]
      > This is a 0day challenge and we are hoping you keep th{is|ese} 0day{|s} to yourself until the vulnerabilit{y|ies} {is|are} patched.
    tags:
      - ⭐⭐⭐⭐
      - 0day

    attachments:
      files:
        - "challenge/"
      exclude:
        - "challenge/flag.txt"
      additional:
        - path: flag.txt
          strContent: "SEKAI{dummy_flag}"
      stripComponents: 1

    flags:
      rctf:
        file: 'challenge/flag.txt'
    
    instancerConfig:
      instancer: k8s
      challengeIntegrationId: "{{ challenge.name | lower }}"
      timeoutMilliseconds: 1800000
      expose:
        - kind: tcp-ssl
          hostPrefix: "{{ challenge.name | lower }}"
          containerName: app
          containerPort: 5000
      config:
        pods:
          - name: app
            ports:
              - protocol: TCP
                port: 5000
            spec:
              nodeSelector:
                kubernetes.io/arch: arm64
              tolerations:
                - key: kubernetes.io/arch
                  operator: Equal
                  value: arm64
                  effect: NoSchedule
              containers:
                - name: app
                  image: "{{ images[challenge.name | lower] }}"
                  resources:
                    limits:
                      cpu: '3'
                      memory: 2Gi
                    requests:
                      cpu: 250m
                      memory: 512Mi
                  readinessProbe:
                    tcpSocket:
                      port: 5000
                    initialDelaySeconds: 5
                    periodSeconds: 3
              restartPolicy: Always
              terminationGracePeriodSeconds: 0
              automountServiceAccountToken: false
              enableServiceLinks: false
            egress: false

deployment:
  images:
    - path: challenge
      dockerfile: Dockerfile.run.aarch64
      name: "{{ challenges[0].name | lower }}"
      tag: latest
      registry_name: instancer-challenges
      platform: linux/arm64

